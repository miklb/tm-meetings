{#
  agenda-drawer.njk — Slide-out agenda panel for meetings with media.
  Desktop: slides in from the right edge; mobile: bottom sheet.

  Only the chrome renders here, and it starts hidden. The agenda list itself
  is rendered once, inline (meeting.njk → .agenda-fallback); agenda-drawer.js
  moves it into [data-agenda-target] and reveals the trigger. Without JS the
  inline agenda simply stays where it is, so nothing is duplicated and every
  #item-… anchor exists exactly once.
#}

<button class="agenda-trigger" type="button" hidden aria-expanded="false" aria-controls="agenda-drawer">
  <span class="agenda-trigger__text">Agenda</span>
  <span class="agenda-trigger__count" aria-hidden="true">{{ detail.items.length }}</span>
  <span class="visually-hidden">{{ detail.items.length }} item{{ "s" if detail.items.length != 1 }}</span>
</button>

<div class="agenda-backdrop" hidden></div>

<aside id="agenda-drawer" class="agenda-drawer" role="dialog" aria-modal="true" aria-labelledby="agenda-drawer-title" hidden inert>

  <div class="agenda-drawer__header">
    <h2 id="agenda-drawer-title" class="agenda-drawer__title">
      Agenda
      <span class="agenda-drawer__item-count">{{ detail.items.length }}
        item{{ "s" if detail.items.length != 1 }}</span>
    </h2>
    <button class="agenda-drawer__close" type="button" aria-label="Close agenda">
      <svg aria-hidden="true" width="20" height="20" viewbox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="4" x2="16" y2="16"/>
        <line x1="16" y1="4" x2="4" y2="16"/>
      </svg>
    </button>
  </div>

  <div class="agenda-drawer__body" data-agenda-target></div>
</aside>
