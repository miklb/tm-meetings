{#
  transcript.njk — Always-visible transcript panel with in-page search
  Expects: detail.transcript_segments, detail.videos, detail.has_video
  Uses videoSeekData filter to compute data-seconds / data-video-part.
  Timestamps are plain links to the video on YouTube; video-player.js
  intercepts them to seek the in-page player when it is ready.
#}
{% if detail.transcript_segments and detail.transcript_segments.length > 0 %}
    <section class="transcript-panel" aria-label="Meeting transcript">

        {# ── Search bar ── #}
        <div class="search-container">
            <label for="transcript-search" class="visually-hidden">Search transcript</label>
            <input type="search" id="transcript-search" class="search-input" placeholder="Search transcript…" autocomplete="off" aria-describedby="search-status">
            <p id="search-status" class="visually-hidden" aria-live="polite"></p>
            <div id="search-results" class="search-results"></div>
        </div>

        {# ── Segment list ── #}
        <div class="transcript-body" tabindex="0" role="region" aria-label="Transcript text">
            {% set currentSpeaker = "" %}
            {% for seg in detail.transcript_segments %}

                {% if seg.speaker and seg.speaker != currentSpeaker %}
                    {% if not loop.first %}
                    </div>
                {% endif %}
                <div class="transcript-turn">
                    <p class="transcript-speaker">{{ seg.speaker }}</p>
                    {% set currentSpeaker = seg.speaker %}
                {% elif not seg.speaker and currentSpeaker != "" %}
                    {% if not loop.first %}
                    </div>
                {% endif %}
                <div class="transcript-turn">
                    {% set currentSpeaker = "" %}
                {% endif %}

                {# Compute seek data when video available #}
                {% if seg.timestamp and detail.has_video %}
                    {% set seek = seg.timestamp | videoSeekData(detail.videos, detail.transcript_baseline) %}
                {% else %}
                    {% set seek = null %}
                {% endif %}

                <p class="transcript-line segment" {% if seek %} data-seconds="{{ seek.seconds }}" data-video-part="{{ seek.videoPart }}" {% endif %}>
                    {% if seg.timestamp %}
                        {% if seek %}
                            <a class="transcript-timestamp" href="https://youtu.be/{{ seek.videoId }}?t={{ seek.seconds | round }}">{{ seg.timestamp }}</a>
                        {% else %}
                            <span class="transcript-timestamp">{{ seg.timestamp }}</span>
                        {% endif %}
                    {% endif %}
                    <span class="segment-text">{{ seg.text }}</span>
                </p>

                {% if loop.last %}
                </div>
            {% endif %}
        {% endfor %}
    </div>
</section>
{% endif %}
