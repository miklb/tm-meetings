</main>

{# Shared Monitor chrome: the site-footer. The data-source attribution lives in
   the "Source" footer column (site.json); the "unofficial resource" disclaimer
   rides in the colophon. #}
{% from "components/site-footer.njk" import siteFooter %}
{% set yr %}{% year %}{% endset %}
{{ siteFooter(
  siteName=site.title,
  tagline=site.description,
  navColumns=site.footerColumns,
  copyright="© " ~ yr ~ " " ~ site.title ~ " · Unofficial resource",
  creed=site.creed
) }}

{# Load video + search scripts only on meeting pages with media #}
{% if meeting and(meeting.has_video or meeting.has_transcript) %}
<script src="https://www.youtube.com/iframe_api"></script>
<script src="/js/video-player.js" defer="defer"></script>
<script src="/js/search.js" defer="defer"></script>
<script src="/js/agenda-drawer.js" defer="defer"></script>
{% endif %}
</body>
</html>