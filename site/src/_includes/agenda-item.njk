{# Render a single agenda item. Set idPrefix before including when the same
   agenda_item_id can appear twice on a page (addendum items re-list parent
   items they amend). Items without an OnBase id (older scrapes) fall back to
   their item number so every id on the page stays unique. #}
{% set idPrefix = idPrefix or "item" %}
{% set itemKey = item.agenda_item_id or ("n" ~ (item.item_number or loop.index)) %}
<li class="agenda-item" id="{{ idPrefix }}-{{ itemKey }}">
    <div class="item-header">
        <span class="item-number">{{ item.item_number }}.</span>
        {% if item.file_number %}
            <span class="file-number">
                <a href="#{{ idPrefix }}-{{ itemKey }}">{{ item.file_number }}</a>
            </span>
        {% endif %}
    </div>

    <p class="item-title">{{ item.title | cleanTitle }}</p>

    {% if item.continued_to_date %}
        <p class="item-notice">Continued to {{ item.continued_to_date }}</p>
    {% endif %}

    {% if item.background | hasContent %}
        <details class="item-background">
            <summary>Background Details</summary>
            <div class="background-text">{{ item.background }}</div>
        </details>
    {% endif %}

    {% if item.documents.length > 0 %}
        <p class="doc-list-heading">Supporting Documents:</p>
        <ul class="doc-list">
            {% for doc in item.documents %}
                <li>
                    <a href="{{ doc.mirrored_url or doc.source_url }}" target="_blank" rel="noopener noreferrer" {% if doc.mirrored_url %} data-original-url="{{ doc.source_url }}" {% endif %}>
                        {{- doc.title -}}
                        <span class="visually-hidden">
                            (opens in new tab)</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</li>
