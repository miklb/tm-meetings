---
layout: base.njk
title: Keyword Notifications — Tampa Meetings
description: Subscribe to receive email alerts when Tampa City Council meeting agenda items match your keywords.
---

<div class="notifications-container">
  <div id="status-banner" class="status-banner hidden" role="alert"></div>

  <noscript>
    <p class="alert-box info">Subscribing and managing keywords needs JavaScript: the forms below send your keywords to the alerts service and show its reply in place. If you cannot enable it, email <a href="mailto:notifications@tampamonitor.com">notifications@tampamonitor.com</a> with your keywords.</p>
  </noscript>

  {# ─── CARD 1: SUBSCRIBE FORM ─── #}
  <div id="subscribe-card" class="notifications-card">
    <div class="card-header">
      <h1>Keyword Notifications</h1>
    </div>

    <div class="card-body">
      <p class="intro-text">
        Get nightly email alerts whenever a new or updated City Council agenda matches topics you care about (e.g., <em>"rezoning", "affordable housing", "Ybor"</em>).
      </p>

      <div class="alert-box info">
        <strong>Public beta:</strong> Free for everyone — subscribe with up to 15 keywords, no account required. <a href="https://tampamonitor.com/support/">Support Tampa Monitor</a> to help keep this and other tools running.
      </div>

      <form id="subscribe-form" novalidate>
        <div class="form-group">
          <label for="sub-email">Email Address</label>
          <input type="email" id="sub-email" name="email" required autocomplete="email" placeholder="your.email@example.com">
        </div>

        <div class="form-group">
          <label for="sub-keywords">Keywords (up to 15)</label>
          <p class="field-help" id="sub-keywords-help">Separate multiple terms with commas. Case-insensitive. Matches title and background texts. Keywords match inside longer words too (<em>"zoning"</em> also catches <em>"rezoning"</em>), except short keywords of 4 letters or fewer (like <em>"MOU"</em>), which match whole words only.</p>

          {# JS turns this into a tag interface; the plain input is the fallback #}
          <div id="tag-container" class="tag-container">
            <input type="text" id="sub-keywords" name="keywords" required aria-describedby="sub-keywords-help" placeholder="e.g. rezoning, stormwater, parks">
          </div>
        </div>

        {% if turnstile.siteKey %}
        <div id="sub-turnstile" class="cf-turnstile" data-sitekey="{{ turnstile.siteKey }}"></div>
        {% endif %}
        <button type="submit" class="btn btn-primary" id="btn-subscribe">Subscribe</button>
      </form>
    </div>

    <div class="card-footer">
      <p>Already subscribed? <button type="button" class="link-btn" id="show-manage-request">Manage your keywords</button></p>
    </div>
  </div>

  {# ─── CARD 2: PASSWORDLESS REQUEST FORM ─── #}
  <div id="request-card" class="notifications-card hidden">
    <div class="card-header">
      <h2>Manage Notifications</h2>
    </div>

    <div class="card-body">
      <p>Enter your email below to receive a secure link to update your keywords or unsubscribe.</p>

      <form id="request-form" novalidate>
        <div class="form-group">
          <label for="req-email">Email Address</label>
          <input type="email" id="req-email" name="email" required autocomplete="email" placeholder="your.email@example.com">
        </div>

        {% if turnstile.siteKey %}
        <div id="req-turnstile" class="cf-turnstile" data-sitekey="{{ turnstile.siteKey }}"></div>
        {% endif %}
        <button type="submit" class="btn btn-primary" id="btn-request">Send Management Link</button>
      </form>
    </div>

    <div class="card-footer">
      <button type="button" class="link-btn" id="back-to-subscribe">← Back to Subscribe</button>
    </div>
  </div>

  {# ─── CARD 3: MANAGE KEYWORDS FORM ─── #}
  <div id="manage-card" class="notifications-card hidden">
    <div class="card-header">
      <h2>Manage Your Keywords</h2>
      <span class="user-badge" id="manage-user-badge">Member</span>
    </div>

    <div class="card-body">
      <div class="form-group">
        <p class="form-label" id="manage-email-label">Subscribed Email</p>
        <p id="manage-email-display" class="email-display" aria-labelledby="manage-email-label"></p>
      </div>

      <form id="manage-form" novalidate>
        <div class="form-group">
          <label for="manage-keywords">Your Keywords</label>
          <p class="field-help" id="limit-help">Active: 0 / 15 keywords max.</p>

          <div id="manage-tag-container" class="tag-container">
            <input type="text" id="manage-keywords" name="keywords" aria-describedby="limit-help" placeholder="Add a keyword...">
          </div>
        </div>

        <button type="submit" class="btn btn-primary" id="btn-save">Save Changes</button>
      </form>

      <hr class="divider">

      <div class="danger-zone">
        <h3>Unsubscribe</h3>
        <p>Permanently remove your email and all monitored keywords from the notification system.</p>
        <button type="button" class="btn btn-danger" id="btn-unsubscribe">Unsubscribe Entirely</button>
      </div>
    </div>

    <div class="card-footer">
      <button type="button" class="link-btn" id="logout-btn">← Switch Accounts</button>
    </div>
  </div>
</div>

<script src="/js/notifications.js" defer></script>
{# Cloudflare Turnstile widget (only renders when a site key is configured) #}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
