{% from "components/breadcrumb.njk" import breadcrumb %}
{{ breadcrumb([
  { label: "Meetings", href: "/" },
  { label: meeting.title, current: true }
]) }}

<h1 class="meeting-title">{{ meeting.title }}
  {% if meeting.agenda_type %}
    <span class="agenda-type">{{ meeting.agenda_type }}</span>
  {% endif %}
</h1>

<div class="meeting-meta">
  <p>
    {{ meeting.date | readableDate }}
    {% if meeting.item_count > 0 %}
      &middot;
      {{ meeting.item_count }}
      agenda item{{ "s" if meeting.item_count != 1 }}
    {% endif %}
  </p>
  {% if meeting.source_url %}
    <p>
      <a href="{{ meeting.source_url }}" target="_blank" rel="noopener noreferrer">View official agenda in OnBase<span class="visually-hidden">
          (opens in new tab)</span></a>
    </p>
  {% endif %}
</div>

{% set detail = meetings.details[meeting.id] %}
{% set hasMedia = detail and(detail.has_video or detail.has_transcript) %}
{% set hasItems = detail and detail.items.length > 0 %}

{% if hasMedia %}
  <p class="media-hint">Transcript timestamps are synced to the video &mdash; select any timestamp to jump to that point.</p>

  {# ── Two-panel layout: video left, transcript right ── #}
  <div class="meeting-layout">

    <div class="video-panel">
      {% include "video.njk" %}
    </div>

    <div class="media-panel">
      {% include "transcript.njk" %}
    </div>

  </div>

  {# ── Agenda drawer chrome (hidden until JS moves the agenda into it) ── #}
  {% if hasItems %}
    {% include "agenda-drawer.njk" %}
  {% endif %}

  {# ── The agenda, rendered once. With JS it moves into the drawer; without
        JS it reads here, below the media grid. ── #}
  <section class="agenda-fallback" id="agenda" aria-labelledby="agenda-heading" data-agenda-source>
    <h2 id="agenda-heading">Agenda</h2>
    {% if hasItems %}
      <ol class="agenda-list">
        {% for item in detail.items %}
          {% include "agenda-item.njk" %}
        {% endfor %}
      </ol>
      {% set prefix = "agenda" %}
      {% include "agenda-addendum.njk" %}
    {% else %}
      <p>No agenda items available for this meeting.</p>
    {% endif %}
  </section>

{% else %}
  {# ── Single column: agenda only (no media) ── #}
  <section id="agenda" aria-labelledby="agenda-heading">
    <h2 id="agenda-heading">Agenda</h2>
    {% if hasItems %}
      <ol class="agenda-list">
        {% for item in detail.items %}
          {% include "agenda-item.njk" %}
        {% endfor %}
      </ol>
      {% set prefix = "agenda" %}
      {% include "agenda-addendum.njk" %}
    {% else %}
      <p>No agenda items available for this meeting.</p>
    {% endif %}
  </section>
{% endif %}
